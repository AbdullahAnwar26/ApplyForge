# ApplyForge frontend (Vite). Copy to .env.local if you need to change a value.
# NEVER put the API token here: VITE_* values are compiled into the browser bundle.
# The token is entered on the Connect screen at runtime.

# API base path used by the browser (default: same-origin /api/v1, forwarded by Vite).
# VITE_API_BASE_URL=/api/v1

# Where the Vite dev/preview server forwards /api (not exposed to the browser).
# API_PROXY_TARGET=http://127.0.0.1:8000
