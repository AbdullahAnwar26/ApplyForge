# ApplyForge frontend (Vite) settings.
# Vite reads env files from THIS folder (frontend/), not from the repository root.
# Copy this file to frontend/.env.local only if you need to change a value; the
# defaults below work for local development with no file at all.
#
# NEVER put the API token here: VITE_* values are compiled into the browser bundle.
# The token is entered on the Connect screen at runtime.

# API base used by the browser. Default: the same-origin path /api/v1, which the
# Vite dev and preview servers forward to API_PROXY_TARGET (no CORS involved).
# An absolute URL (e.g. http://localhost:8000/api/v1) bypasses that forwarding and
# only works if the backend's CORS_ALLOWED_ORIGINS includes the page's origin
# (by default only http://localhost:5173 and http://localhost:5174).
# VITE_API_BASE_URL=/api/v1

# Where the Vite dev/preview server forwards /api (server-side only, not exposed
# to the browser). Default: http://127.0.0.1:8000
# API_PROXY_TARGET=http://127.0.0.1:8000
