# ==========================================
# ApplyForge - Environment Variables Example
# ==========================================
# WARNING: NEVER COMMIT ACTUAL .env FILES TO GIT
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES

# -----------------
# Backend (Django)
# -----------------
# DEBUG defaults to False when unset (fail closed). Local development must set
# DEBUG=True explicitly. With DEBUG=False the backend refuses to start unless
# SECRET_KEY, API_TOKEN and DATABASE_URL are set, and enables HTTPS hardening.
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# Deployment only. Trust the HTTPS proxy's forwarded-protocol header ONLY when the
# app is reachable exclusively through that proxy and the proxy always overwrites
# the header. Format: HTTP_<HEADER_NAME>,<value>
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# HSTS preload is off by default (hard to undo); opt in deliberately.
# SECURE_HSTS_PRELOAD=False

# Absolute paths. Defaults: backend/staticfiles and backend/media.
# STATIC_ROOT=/srv/applyforge/static        # target of `manage.py collectstatic`
# MEDIA_ROOT=/srv/applyforge/media          # uploaded resumes: persistent, backed up

# Shared API token. Clients send: Authorization: Bearer <API_TOKEN>
API_TOKEN=change-me-to-a-long-random-string

# Application generation - local Ollama only (no fallback provider)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:1.7b
# OLLAMA_TEMPERATURE=0.3
# OLLAMA_MAX_TOKENS=768
# OLLAMA_TIMEOUT_SECONDS=180
# GENERATION_MAX_JD_CHARS=6000
# GENERATION_MAX_RESUME_CHARS=6000

# Database Configuration (PostgreSQL example)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=applyforge
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis / Celery
# REDIS_URL=redis://localhost:6379/0

# -----------------
# Frontend (Vite/React)
# -----------------
# Not configured here: this root .env is read only by the Django backend.
# Vite reads frontend/.env, frontend/.env.local, ... (see frontend/.env.example).
# By default the frontend calls the same-origin path /api/v1, which the Vite
# dev/preview server forwards to http://127.0.0.1:8000 - no frontend settings
# are needed for local use. The API token is entered on the Connect screen;
# never put it in any VITE_* variable (those are compiled into the bundle).
