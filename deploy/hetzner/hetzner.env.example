# deploy/hetzner/provision.sh configuration. Copy to deploy/hetzner/hetzner.env (git-ignored). No secrets:
# the API token comes from the HCLOUD_TOKEN environment variable only.
PREFIX=af-staging
IMAGE=ubuntu-26.04
# App server: 4 vCPU / 8 GB (CX33) if available, else CX23 (2 vCPU / 4 GB) is enough for staging.
APP_TYPE=cx33
APP_LOCATION=hel1
# Backup server: small amd64 plan in a DIFFERENT location from the app server. CX23 (40 GB) over CPX02
# (20 GB) for +EUR 0.50/month: the export and the vault each hold a copy of every archive.
BACKUP_TYPE=cx23
BACKUP_LOCATION=fsn1
# Hetzner's own daily image backups of the backup server (+20 % of its price).
BACKUP_SERVER_BACKUPS=yes
# Admin SSH PUBLIC key installed for root at creation (bootstrap only; the installer moves it to the admin user).
SSH_PUBKEY_FILE=/home/you/.ssh/applyforge_admin_ed25519.pub
# Your current public IPv4 as /32: the only source allowed to SSH during bootstrap (close-ssh removes it).
ADMIN_CIDR=198.51.100.7/32
