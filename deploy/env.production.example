# ApplyForge - production environment for the private/VPN deployment (Milestone 8.4c).
#
# PLACEHOLDERS ONLY. After extracting a release on the server (runbook section 5),
# copy it from that release to /etc/applyforge/applyforge.env and replace every <...>
# value there - never in this file, never in the repository:
#
#   sudo install -o root -g applyforge -m 0640 "$REL/deploy/env.production.example" /etc/applyforge/applyforge.env
#   sudoedit /etc/applyforge/applyforge.env
#
# Format: systemd EnvironmentFile - one KEY=value per line, no `export`, no shell
# expansion. Avoid quotes and spaces in values (generate secrets as shown below).
#
# deploy/preflight.py checks this file's effect on every service start and refuses
# to start on: DEBUG not explicitly false, placeholder or weak secrets, a non-
# PostgreSQL DATABASE_URL, a wildcard host, non-HTTPS origins, HSTS
# includeSubDomains/preload, relative or wrong storage paths, or a loadable .env.

# --- Fail-closed basics ------------------------------------------------------
# Must be False. settings.py already defaults to False when DEBUG is missing; it is
# set explicitly so a stray development value can never be inherited.
DEBUG=False

# Never load a development .env: settings.py loads the file named here, and this
# path must NOT exist (the systemd unit sets the same value as a fallback).
APPLYFORGE_DOTENV=/nonexistent/applyforge-no-dotenv

# --- Secrets -------------------------------------------------------------------
# Generate each on the server, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY: at least 50 characters. API_TOKEN: at least 32 characters, and
# different from SECRET_KEY. The API token is what users paste into the web UI.
SECRET_KEY=<generate-a-random-secret-key>
API_TOKEN=<generate-a-random-api-token>

# --- Database ------------------------------------------------------------------
# PostgreSQL on this host only (the systemd unit allows network access to
# localhost only). Start from an EMPTY database; the runbook runs migrations.
# URL-encode special characters in the password.
DATABASE_URL=postgres://applyforge:<database-password>@127.0.0.1:5432/applyforge

# --- Host and origins ------------------------------------------------------------
# The private host name served by nginx (no wildcards, no IP addresses needed).
ALLOWED_HOSTS=<applyforge.vpn.example>
CSRF_TRUSTED_ORIGINS=https://<applyforge.vpn.example>
# The UI and API share one origin, so no cross-origin access is allowed. Keep empty
# (an unset value would fall back to the localhost development origins).
CORS_ALLOWED_ORIGINS=

# --- HTTPS behind nginx ------------------------------------------------------------
# nginx terminates TLS and ALWAYS overwrites X-Forwarded-Proto with "https";
# Gunicorn listens on 127.0.0.1 only, so no other client can set this header.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Deliberately off for this deployment (hard to undo; could affect sibling hosts).
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Storage -------------------------------------------------------------------------
# Outside the release directory so code upgrades and rollbacks never touch them.
# MEDIA_ROOT is the only path the service may write; nginx never serves it.
STATIC_ROOT=/var/lib/applyforge/static
MEDIA_ROOT=/var/lib/applyforge/media

# --- Logging / locale ----------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

# --- Optional features: DISABLED on this server ------------------------------------
# The collector (LinkedIn/Playwright) and draft generation (Ollama) are blocked at
# nginx, no browser or LinkedIn session is installed, and the service has no network
# access beyond localhost. Leave these unset. Do not add OLLAMA_*, COLLECTOR_* or
# REDIS_URL settings until those features are deliberately enabled.
