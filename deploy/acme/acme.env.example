# /etc/applyforge/acme/acme.env (root 0600) - read by applyforge-acme. PLACEHOLDERS ONLY in the repository.
ACME_DOMAIN=<applyforge.example.org>
ACME_EMAIL=<owner@example.org>
ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# After a successful staging run: ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
ACME_DNS_PROVIDER=<lego provider name, e.g. cloudflare or rfc2136>
ACME_DNS_RESOLVERS=1.1.1.1:53
ACME_RENEW_DAYS=30
# The provider's own lego variables. The token must be limited to the VALIDATION zone (TXT records):
# CLOUDFLARE_DNS_API_TOKEN=<token scoped to the validation zone only>
