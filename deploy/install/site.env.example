# ApplyForge site configuration for deploy/install/applyforge-install.
# Copy to /etc/applyforge/site.env on BOTH servers (identical content). Root 0644.
# Contains NO secrets: public keys and addresses only. Secrets are supplied as files (see INPUTS below)
# or generated on the server and never leave it.
#
# Fixed private addressing (architecture constants, not configurable here):
#   10.99.0.0/24  device VPN on the app server (wg0, app = 10.99.0.1, devices .2-.254)
#   10.98.0.0/30  backup link (wg1): app 10.98.0.1 <-> backup 10.98.0.2
#   10.97.0.0/24  admin VPN on the backup server (wg0, backup = 10.97.0.1, devices .2-.254)

# Private host name served by the app (must be under a domain you control for ACME; never published
# as an A record in public DNS).
APP_HOST=applyforge.example.org

# Public IPv4 addresses of the two servers (from provisioning).
APP_PUBLIC_IPV4=203.0.113.10
BACKUP_PUBLIC_IPV4=203.0.113.20

# WireGuard backup-link public keys: run `applyforge-install keys --role app|backup` on each server
# and paste the printed wg1 public key here. Leave empty until both are known.
APP_WG1_PUBKEY=
BACKUP_WG1_PUBKEY=

# Admin account created on both servers (SSH keys only, sudo). Its authorized_keys are copied from
# ADMIN_SSH_KEYS_FROM on first install (the provider puts the provisioning key into root's file).
ADMIN_USER=afadmin
ADMIN_SSH_KEYS_FROM=/root/.ssh/authorized_keys

# Time zone for Django (DJANGO_TIME_ZONE).
TIME_ZONE=UTC

# Operator-supplied files are read from INPUTS_DIR (root 0700) when present, installed with the
# right owner and mode, and then deleted from INPUTS_DIR:
#   backup-recipients.txt  app:    the two age PUBLIC recipients (primary + escrow), required for backups
#   healthchecks.env       both:   HC_<CHECK>=<ping URL> lines (secret), enables monitoring timers
#   acme.env               app:    lego/DNS-01 settings with the scoped DNS credential (secret)
INPUTS_DIR=/root/applyforge-inputs

# Releases kept on the app server (current + previous for rollback).
KEEP_RELEASES=3
