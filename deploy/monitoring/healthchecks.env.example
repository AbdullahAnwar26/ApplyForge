# /etc/applyforge/healthchecks.env (root 0600) - one ping URL per check. PLACEHOLDERS ONLY in the repository.
# App server: HC_HEALTH, HC_DNS, HC_DISK, HC_CERT, HC_BACKUP. Backup server: HC_HEARTBEAT, HC_BACKUP_DISK, HC_SEAL.
HC_HEALTH=https://hc-ping.com/<uuid>
HC_DNS=https://hc-ping.com/<uuid>
HC_DISK=https://hc-ping.com/<uuid>
HC_CERT=https://hc-ping.com/<uuid>
HC_BACKUP=https://hc-ping.com/<uuid>
