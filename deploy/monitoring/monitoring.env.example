# /etc/applyforge/monitoring.env (0644, no secrets) - settings for applyforge-check and applyforge-cert-deploy.
APP_HOST=<applyforge.example.org>
VPN_ADDR=10.99.0.1
DISK_PATHS="/ /var/lib/postgresql"
DISK_MAX_PCT=80
CERT_FILE=/etc/ssl/applyforge/applyforge.crt
CERT_MIN_DAYS=21
# On the backup server: DISK_PATHS="/ /srv/applyforge-backups /srv/applyforge-vault" and CHECK_NAME_PREFIX=backup-
CHECK_NAME_PREFIX=
